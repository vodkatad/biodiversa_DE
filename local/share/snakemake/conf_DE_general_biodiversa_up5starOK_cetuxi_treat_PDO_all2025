rule samples_data:
    input: meta=BIT_DIR+"/selected_metadata_annot_final_nolinfo_nooutlier_replisafe", wanted="wanted"
    output: "samples_data"
    shell:
        """
			echo -e "id\\tsample\\tbatch\\ttreat" > {output}
			cat {input.meta} | cut -f 1,6,7 |  filter_1col 3 {input.wanted} | tr "_" "\\t" | \\
			bawk '$6=="NT" {{print $1, substr($1,0,7), $2,"NT"}} $6!="NT"{{print $1,substr($1,0,7),$2,"cetuxi"}}' >> {output}
        """

