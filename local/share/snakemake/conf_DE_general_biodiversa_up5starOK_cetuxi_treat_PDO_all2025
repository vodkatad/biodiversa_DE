rule striplots_chosen:
    input: wanted=BASE_DATA+'/{what}', dds="dds.Rdata"
    output: directory("{what}_lineplots_{class}")
    params: tool=BIN_DIR+"/striplots_single_sample_mirated", chosen=CHOSEN
