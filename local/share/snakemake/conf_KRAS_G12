# Funzione per generare il path della cartella output per ogni confronto
def get_comparison_dir(smodel, nom, den):
    """
    Genera il path della directory per un confronto specifico
    Es: results/model1/treatment_vs_control/
    """
    return f"results/{smodel}/{nom}_vs_{den}"

# Funzione helper per ottenere i confronti di un modello specifico
def get_model_comparisons(smodel):
    """
    Restituisce la lista di confronti per un modello specifico
    """
    return MODEL_COMPARISONS.get(smodel, [])
