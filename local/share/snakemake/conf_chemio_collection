COUNTS="counts.tsv.gz"
rule merge_counts:
    input: old="old_counts.tsv.gz", new=NEW_COUNTS
    output: COUNTS
    shell:
        """
            paste <(zcat {input.old} | head -n1) <(zcat {input.new} | head -n1) > {output}.tmp
            paste <(zcat {input.old} | sed 1d ) <(zcat {input.new} | sed 1d | cut -f 1 --complement) >> {output}.tmp
            gzip -c {output}.tmp > {output}
            rm {output}.tmp
        """


