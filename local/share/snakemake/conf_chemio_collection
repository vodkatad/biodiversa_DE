    input: counts=OLD_COUNTS, wanted="old_samples.tsv"
    output: matrix="old_counts.tsv.gz"
    run:
        import pandas as pd
        counts = pd.read_csv(input.counts, sep="\t", index_col=0, compression='gzip')
        wanted = pd.read_csv(input.wanted, sep="\t", index_col=1, header=None)
        counts = counts[wanted.index.tolist()]       
        counts.to_csv(output.matrix, sep="\t", compression='gzip', header=True)


