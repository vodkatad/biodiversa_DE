def get_all_deg_outputs():
    outputs = []
    for smodel in SMODELS:
        for nom, den in MODEL_COMPARISONS.get(smodel, []):
            comp_dir = get_comparison_dir(smodel, nom, den)
            outputs.append(f"{comp_dir}/{smodel}_{WHAT}_cutoff{ALPHA}-{nom}.vs.{den}.deseq2.tsv")
    return outputs

def get_all_go_outputs():
    outputs = []
    for smodel in SMODELS:
        for nom, den in MODEL_COMPARISONS.get(smodel, []):
            comp_dir = get_comparison_dir(smodel, nom, den)
            for direction in DIRECTIONS:
                outputs.append(f"{comp_dir}/GO_results_{smodel}_{WHAT}_cutoff{ALPHA}-{nom}.vs.{den}_{direction}.tsv")
    return outputs

def get_all_gsea_outputs():
    outputs = []
    for smodel in SMODELS:
        for nom, den in MODEL_COMPARISONS.get(smodel, []):
            comp_dir = get_comparison_dir(smodel, nom, den)
            for msign in MSIGN_TYPES:
                outputs.append(f"{comp_dir}/GSEA_results_{smodel}_{msign}_{WHAT}_cutoff{ALPHA}-{nom}.vs.{den}.tsv")
    return outputs

rule all:
    input:
        # Per ogni modello, genera i file di QC nella cartella del modello
        expand("results/{smodel}/{smodel}_dds.Rdata", smodel=SMODELS),
        expand("results/{smodel}/{smodel}_fpkm.gz", smodel=SMODELS),
        expand("results/{smodel}/{smodel}_tmm.gz", smodel=SMODELS),
        expand("results/{smodel}/{smodel}_vsd.gz", smodel=SMODELS),
        
        # Tutti i risultati DEG (specifici per modello)
        get_all_deg_outputs(),
        
        # Tutti i risultati GO (specifici per modello)
        get_all_go_outputs(),
        
        # Tutti i risultati GSEA (specifici per modello)
        get_all_gsea_outputs()

rule plots:
    input: 
        counts="counts_kras.gz",
        metadata="{smodel}_samples_data"
    output: 
        dds="results/{smodel}/{smodel}_dds.Rdata", 
        fpkm="results/{smodel}/{smodel}_fpkm.gz", 
        tmm="results/{smodel}/{smodel}_tmm.gz", 
        vsd="results/{smodel}/{smodel}_vsd.gz"
    params: 
        tool=BIN_DIR+"/deseq2_qc_multisamples", 
        design=DESIGN, 
        prefix=SPECIES, 
        minc=MINC, 
        minsamples=MINSAMPLES, 
        gene_len=GENE_LEN, 
        cores=CORES
    
    shell:
        """
        {params.tool} {input.counts} {input.metadata} {params.design} {params.prefix} \
            {params.minc} {params.minsamples} {params.gene_len} {output} {params.cores}
        """

rule de:
    input: 
        dds="results/{smodel}/{smodel}_dds.Rdata"
    output: 
        tsv="{comp_dir}/{smodel}_{what}_cutoff{alpha}-{nom}.vs.{den}.deseq2.tsv", 
        volcano="{comp_dir}/{smodel}_{what}_cutoff{alpha}-{nom}.vs.{den}.deseq2.pdf"
    params: 
        threads=CORES, 
        alpha="{alpha}", 
        factor="{what}", 
        nom="{nom}", 
        den="{den}", 
        lfc=LFC
    
    script: 
        SRC_DIR+"/deseq2_diff_newvolcano_multisamples.R"

rule go_input_up_down:
    input: 
        tsv="{comp_dir}/{smodel}_{what}_cutoff{alpha}-{nom}.vs.{den}.deseq2.tsv"
    output: 
        up="{comp_dir}/{smodel}_{what}_cutoff{alpha}-{nom}.vs.{den}.goinsplit_up.tsv", 
        down="{comp_dir}/{smodel}_{what}_cutoff{alpha}-{nom}.vs.{den}.goinsplit_down.tsv"
    params: 
        thr=PVAL, 
        specie=SPECIES, 
        lfc=LFC
    
    shell:
        """
        sed 1d {input} | awk '$7 < {params.thr} && $3 > {params.lfc} {{print $1}}' | \
            perl -pane 's/^{params.specie}_(.+)/$1/g' > {output.up}
        sed 1d {input} | awk '$7 < {params.thr} && $3 < -{params.lfc} {{print $1}}' | \
            perl -pane 's/^{params.specie}_(.+)/$1/g' > {output.down}
        """

rule go_universe:
    input: 
        tsv="{comp_dir}/{smodel}_{what}_cutoff{alpha}-{nom}.vs.{den}.deseq2.tsv"
    output: 
        gene_univ="{comp_dir}/{smodel}_{what}_cutoff{alpha}-{nom}.vs.{den}.gouniverse.tsv"
    params: 
        specie=SPECIES
    
    shell:
        """
        sed 1d {input} | cut -f 1 | perl -pane 's/^{params.specie}_(.+)/$1/g' > {output}
        """

rule go_analysis_plot:
    input: 
        gene_list="{comp_dir}/{smodel}_{what}_cutoff{alpha}-{nom}.vs.{den}.goinsplit_{direction}.tsv", 
        gene_univ="{comp_dir}/{smodel}_{what}_cutoff{alpha}-{nom}.vs.{den}.gouniverse.tsv"
    output: 
        GO_r="{comp_dir}/GO_results_{smodel}_{what}_cutoff{alpha}-{nom}.vs.{den}_{direction}.tsv", 
        out_dir=directory("{comp_dir}/barplot_go_{smodel}_{what}_cutoff{alpha}-{nom}.vs.{den}_{direction}")
    conda:
        GO_ENV
    
    script: 
        SRC_DIR+'/GO_analysis_multisamples.R'

rule gsea_input_2:
    input: 
        tsv="{comp_dir}/{smodel}_{what}_cutoff{alpha}-{nom}.vs.{den}.deseq2.tsv"
    output: 
        gene_res_freq="{comp_dir}/{smodel}_{what}_cutoff{alpha}-{nom}.vs.{den}.gseain_2.tsv"
    params: 
        lfc=LFC, 
        thr=PVAL, 
        specie=SPECIES
    
    shell:
        """
        printf "gene\\tFreq\\n" > {output}
        sed 1d {input} | awk -v OFS='\\t' '{{print $1, $3}}' | \
        perl -pane 's/^{params.specie}_(.+)/$1/g' >> {output}
        """

rule gsea_analysis_plot:
    input: 
        gene_res_freq="{comp_dir}/{smodel}_{what}_cutoff{alpha}-{nom}.vs.{den}.gseain_2.tsv"
    output: 
        GSEA_r="{comp_dir}/GSEA_results_{smodel}_{msign}_{what}_cutoff{alpha}-{nom}.vs.{den}.tsv", 
        GSEA_ridgeplot="{comp_dir}/{smodel}_gsea_ridgeplot_{msign}_{what}_cutoff{alpha}-{nom}.vs.{den}.pdf"
    conda:
        GO_ENV
    
    script: 
        SRC_DIR+'/GSEA_analysis.R'


