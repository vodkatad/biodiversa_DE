rule all_sign:
    input: expand("{k}vsAll/{what}_cutoff{alpha}-{nom}.vs.{den}.deseq2_sign.tsv", zip, k=CLUSTER, what=["cluster"]*len(CLUSTER), alpha=[0.05]*len(CLUSTER), nom=NOM_CLUSTER, den=["All"]*len(CLUSTER))
rule sign:
    input: "{k}vsAll/{what}_cutoff{alpha}-{nom}.vs.{den}.deseq2.tsv"
    output: "{k}vsAll/{what}_cutoff{alpha}-{nom}.vs.{den}.deseq2_sign.tsv"
    shell:
        """
            bawk '$7<0.05' {input} | bawk 'NR==1{{print "gene",$0}}NR!=1{{print $0}}'  | cut -f 1,2,3,4,7  | sed s'/H_//1'  > {output}
        """

rule select_annote:
    input: "{k}vsAll/{what}_cutoff{alpha}-{nom}.vs.{den}.deseq2_sign.tsv"
    output: "{k}vsAll/{what}_cutoff{alpha}-{nom}.vs.{den}.deseq2_sign_genedesc.tsv"
    params: tool=BIN_DIR+"/add_description"
    shell:
        """
            {params.tool} -d -i {input} -o {output} -t GENENAME -f SYMBOL -n 1
        """

