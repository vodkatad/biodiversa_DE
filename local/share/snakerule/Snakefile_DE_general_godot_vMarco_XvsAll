rule plots:
    input: counts=COUNTS, metadata="{k}vsAll/samples_data_{k}vsAll"
    output: "{k}vsAll/dds.Rdata", "{k}vsAll/fpkm.tsv.gz", "{k}vsAll/tmm.tsv.gz", "{k}vsAll/vsd.tsv.gz"
    params: tool=BIN_DIR+"/deseq2_qc_methy", design=DESIGN, prefix=SPECIES, minc=MINC, minsamples=MINSAMPLES, gene_len=GENE_LEN, cores=CORES
    shell:
        """
            {params.tool} {input.counts} {input.metadata} {params.design} {params.prefix} {params.minc} {params.minsamples} {params.gene_len} {output} {params.cores}
        """

rule de:
    input: "{k}vsAll/dds.Rdata"
    output: tsv="{k}vsAll/{what}_cutoff{alpha}-{nom}.vs.{den}.deseq2.tsv", 
            volcano="{k}vsAll/{what}_cutoff{alpha}-{nom}.vs.{den}.deseq2.pdf"
    params: threads=CORES, alpha="{alpha}", factor="{what}", nom="{nom}", den="{den}", lfc=LFC
    script: SRC_DIR+"/deseq2_diff.R"

## rule that removes H_ / M_ and filters only one kind of genes from metric.tsv.gz files
rule s:
    input: "{k}vsAll/{metric}.tsv.gz"
    output: "{k}vsAll/{metric}_"+SPECIES+".tsv.gz"
    params: specie=SPECIES
    shell:
        """
            zcat {input} | head -n 1 > {output}.tmp || echo 'plh'
            zcat {input} | sed 1d | sed 's/^{params.specie}_//1' >> {output}.tmp
            gzip -c {output}.tmp > {output}
            rm {output}.tmp
        """

#### begin remove in V2 ####
rule my_beloved:
    input: "{k}vsAll/{metric}_"+SPECIES+".tsv.gz"
    output: temp("{gene, \w+}_{metric}.tsv")
    shell:
        """
            zcat {input} | head -n1 | tr "." "-" > {output}.tmp || echo 'plh'
            zcat {input} | bawk '$1=="{wildcards.gene}"' | cut -f 1 --complement >> {output}.tmp
            transpose < {output}.tmp > {output}
            rm {output}.tmp
        """

