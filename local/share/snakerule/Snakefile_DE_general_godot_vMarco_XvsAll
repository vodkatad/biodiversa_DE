            GSEA_ridgeplot = "{k}vsAll/gsea_ridgeplot_{msign}_{what}_cutoff{alpha}-{nom}.vs.{den}.pdf",
            rdata = "{k}vsAll/GSEA_results_{msign}_{what}_cutoff{alpha}-{nom}.vs.{den}.Rdata"
    script: SRC_DIR+'/GSEA_analysis.R'
